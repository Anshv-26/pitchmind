# PitchMind environment configuration - EXAMPLE ONLY.
#
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit
# a real key. Every value below is optional: with no keys configured the
# providers report empty capability sets, and the test suite runs fully
# offline without credentials.

# --- Provider credentials (free tiers; no payment required) ---------------
# football-data.org free tier: fixtures, results, standings. 10 req/min.
PITCHMIND_FOOTBALL_DATA_ORG_KEY=

# API-Football (api-sports.io) free tier: live score/events/lineups/stats.
# 100 req/day, 10 req/min. Current-season access is NOT assumed - verify with
# `python scripts/probe_live_provider.py` before enabling live_verified=True.
PITCHMIND_API_FOOTBALL_KEY=

# --- Cache TTLs (seconds) -------------------------------------------------
# Live snapshot TTL. V1 default is 300 (~5 min), deliberately relaxed for a
# small-scale demo. Lower to 60 or 30 here - not in code - if API credits are
# purchased later.
PITCHMIND_LIVE_TTL_SECONDS=300
PITCHMIND_STANDINGS_TTL_SECONDS=1800
PITCHMIND_FIXTURES_TTL_SECONDS=1800
PITCHMIND_METADATA_TTL_SECONDS=21600

# --- HTTP timeouts (seconds) ---------------------------------------------
PITCHMIND_HTTP_CONNECT_TIMEOUT=5
PITCHMIND_HTTP_READ_TIMEOUT=10
